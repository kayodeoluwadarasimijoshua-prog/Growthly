# Public origin used for canonical URLs, sitemap and robots.txt.
# Set this to the final HTTPS domain before launch (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://growthly.com.ng
# Enable ONLY on the approved production deployment; previews stay noindex.
SITE_INDEXING_ENABLED=false
BING_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Supabase public project settings: safe to expose through NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional lead email delivery via Resend. If Supabase storage is not configured,
# all three values AND the separate ONLINE_INQUIRIES_ENABLED opt-in are required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_EMAIL=

# Optional analytics: leave disabled until account measurement/privacy review.
# An account ID alone will NOT enable tags. Ads tags are not loaded by this site.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Local/review only: show permission-pending project assets; never enable on production.
# This checkout has no valid StarXCO image bytes; keep this disabled.
PROJECT_IMAGE_REVIEW_MODE=false

# Apply/verify the retry migration before enabling database idempotency.
INQUIRY_IDEMPOTENCY_ENABLED=false

# Only true after the host is verified to overwrite spoofed forwarded headers.
TRUST_PROXY_HEADERS=false

# Optional existing-Supabase shared limiter: requires migration and cost approval.
DISTRIBUTED_RATE_LIMIT_ENABLED=false
RATE_LIMIT_HASH_SECRET=

# Public content CMS: apply content/storage migrations, publish an initial snapshot,
# then enable in build AND runtime on the chosen host and redeploy once.
# Later supported publications need no rebuild. Does not opt into lead collection.
SITE_CMS_ENABLED=false
# Explicit, separate owner approval after live delivery/privacy acceptance.
ONLINE_INQUIRIES_ENABLED=false
